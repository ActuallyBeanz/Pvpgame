extends Resource
## One sound id: a few variations plus how they play. Lives inside
## res://data/registry/sounds.tres (generated by art_src/audio/make_sfx.py, then
## freely editable in the Inspector).

@export var streams: Array[AudioStream] = []   ## variations; one is picked at random (no instant repeats)
@export_range(-40.0, 12.0, 0.5) var volume_db := 0.0
@export_range(0.5, 2.0, 0.01) var pitch_min := 0.95
@export_range(0.5, 2.0, 0.01) var pitch_max := 1.05
@export var bus := &"SFX"                      ## Master / Music / SFX / Ambience / UI
@export var spatial := true                    ## false = plays flat (UI, item jingles, ambience)
@export var max_distance := 40.0               ## metres until silent (3D only)
@export_range(1, 16) var max_voices := 4       ## same id playing at once; oldest gets cut
@export var loop := false
